@misc{eaton_netcdf_2025,
	title = {{NetCDF} {Climate} and {Forecast} ({CF}) {Metadata} {Conventions}},
	copyright = {Creative Commons Zero v1.0 Universal},
	url = {https://zenodo.org/doi/10.5281/zenodo.17801666},
	doi = {10.5281/ZENODO.17801666},
	abstract = {This document describes the CF conventions for climate and forecast metadata designed to promote the processing and sharing of files created with the netCDF Application Programmer Interface. The conventions define metadata that provide a definitive description of what the data in each variable represents, and of the spatial and temporal properties of the data. This enables users of data from different sources to decide which quantities are comparable, and facilitates building applications with powerful extraction, regridding, and display capabilities.
The CF conventions generalize and extend the COARDS conventions. The extensions include metadata that provides a precise definition of each variable via specification of a standard name, describes the vertical locations corresponding to dimensionless vertical coordinate values, and provides the spatial coordinates of non-rectilinear gridded data. Since climate and forecast data are often not simply representative of points in space/time, other extensions provide for the description of coordinate intervals, multidimensional cells and climatological time coordinates, and indicate how a data value is representative of an interval or cell. This standard also relaxes the COARDS constraints on dimension order and specifies methods for reducing the size of datasets.},
	urldate = {2026-09-14},
	publisher = {CF Community},
	author = {Eaton, Brian and Gregory, Jonathan and Drach, Bob and Taylor, Karl and Hankin, Steve and Caron, John and Signell, Rich and Bentley, Phil and Rappa, Greg and Höck, Heinke and Pamment, Alison and Juckes, Martin and Raspaud, Martin and Blower, Jon and Horne, Randy and Whiteaker, Timothy and Blodgett, David and Zender, Charlie and Lee, Daniel and Hassell, David and Snow, Alan D. and Kölling, Tobias and Allured, Dave and Jelenak, Aleksandar and Soerensen, Anders Meier and Gaultier, Lucile and Herlédan, Sylvain and Manzano, Fernando and Bärring, Lars and Barker, Christopher and Bartholomew, Sadie L. and Lavergne, Thomas and Lawrence, Bryan and Massey, Neil and Cofiño, Antonio S. and McGinnis, Seth and Laake, Patrick Van},
	month = dec,
	year = {2025},
	note = {Version Number: 1.13},
	file = {PDF:/home/emil/Zotero/storage/XETSV7GN/Eaton et al. - 2025 - NetCDF Climate and Forecast (CF) Metadata Conventions.pdf:application/pdf},
}

@article{wiemer_information_2026,
	title = {Information and {Data} {Flow} of {Underway} {Research} {Data} from {German} {Research} {Vessels}},
	url = {https://zenodo.org/records/20183051},
	doi = {10.5281/zenodo.20183051},
	abstract = {This document describes the systematic workflow of Underway Research Data collected aboard German research vessels – from expedition planning and data acquisition to data processing, publication, and reuse. It outlines the interconnected data management systems used throughout this workflow. The data workflow is divided into three phases: before, during, and after an expedition.

The main objective is to enable a highly automated, machine-actionable, and quality-assured data workflow that ensures the sustainable archiving and global accessibility of research data. This document presents the organizational processes and technical infrastructure established through the BMFTR-funded Underway Research Data project in collaboration with the DataHub initiative of Helmholtz Earth and Environment.

The document is primarily intended for the seagoing German marine research community and aims to provide a transparent overview of the data workflow.},
	language = {eng},
	urldate = {2026-09-14},
	publisher = {Zenodo},
	author = {Wiemer, Gauvain and Anselm, Norbert and Baldewein, Linda and Becker, Marius and Betz, Maximilian and Börner, Gregor and Riemann-Campe, Kathrin and Damaske, Daniel and Devey, Colin and Dorschel, Boris and Dreutter, Simon and Faber, Claas and Felden, Janine and Berndt, Janiene and Glöckner, Frank Oliver and Hoppmann, Mario and Höring, Flavia and Immoor, Sebastian and Kleeberg, Ulrike and Kolbe, Martin and Köllner, Manuela and Konopatzky, Peter and Koppe, Roland and Kopte, Robert and Lingner, Stefan and Lorenz, Sören and Marki, Alexandra and Mehrtens, Hela and Michels, Emil and Oelker, Julia and Pieck, Daniela and Rehage, Marianne and Ruegg, Noemi and Schäfer, Angela and Schiebel, Ralf and Schirnick, Carsten and Schlundt, Michael and Schumacher, Mia and Selke, Niklas and Slagter, Hans and Tamm, Susanne and Schulze Tenberge, Yvonne and Tippenhauer, Sandra and Voss, Daniela and Walter, Andreas and Walter, David and Wölfl, Anne-Cathrin},
	month = may,
	year = {2026},
	file = {Full Text PDF:/home/emil/Zotero/storage/FGVU7YI3/Wiemer et al. - 2026 - Information and Data Flow of Underway Research Data from German Research Vessels.pdf:application/pdf},
}

